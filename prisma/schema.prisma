generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum RequestStatus {
  PENDING
  PENDING_FINAL // αρχικά εγκεκριμένη από διαχειριστή, αναμένει τελική έγκριση
  APPROVED
  REJECTED
}

enum AbsenceType {
  DOCTOR
  TRAINING
}

enum BalanceCategory {
  OVERTIME
  HOLIDAYS
  ANNUAL
  ACCUMULATED
  DAYS_LEAVE
  DAYS_DAYOFF
  DAYS_ACCUMULATED
}

enum SwapStatus {
  PENDING
  COLLEAGUE_DECLINED
  COLLEAGUE_ACCEPTED
  PENDING_FINAL // αρχικά εγκεκριμένη από διαχειριστή, αναμένει τελική έγκριση
  ADMIN_REJECTED
  APPROVED
}

enum EmployeeType {
  PERMANENT // Μόνιμος
  TWP       // Τ.Ω.Π.
}

enum ShiftType {
  DAY   // Ημέρα
  NIGHT // Νύχτα
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(EMPLOYEE)
  staffMember    Boolean      @default(true) // false = διαχειριστής χωρίς φυσική παρουσία στο προσωπικό (δεν εμφανίζεται σε καταστάσεις/βάρδιες)
  finalApprover  Boolean      @default(false) // true = διαχειριστής τελικής έγκρισης
  department     String?
  shiftGroup     String?
  phone          String?
  qualifications String[]     @default([])
  employeeType   EmployeeType @default(TWP)
  rank           String?
  shiftType      ShiftType? // μόνο για Μονιάτης (Ημέρα/Νύχτα)

  // Τ.Ω.Π. — υπόλοιπα σε ώρες
  hoursOvertime    Float @default(0) // Υπερωρίες
  hoursHolidays    Float @default(0) // Αργίες
  hoursAnnual      Float @default(0) // Έτους
  hoursAccumulated Float @default(0) // Συσσωρευμένη (μέγιστο απόθεμα 334.40 ώρες)

  // Μόνιμος — υπόλοιπα σε ημέρες
  daysLeave       Int @default(0) // Άδεια
  daysDayOff      Int @default(0) // Ημεραργία (R/D)
  daysAccumulated Int @default(0) // Συσσωρευμένη (μέγιστο απόθεμα 100 ημέρες)

  createdAt DateTime @default(now())

  requests             LeaveRequest[]
  adjustments          BalanceAdjustment[]
  swapRequestsSent     ShiftSwap[]         @relation("SwapRequester")
  swapRequestsReceived ShiftSwap[]         @relation("SwapColleague")
}

model LeaveRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  startDate       DateTime
  endDate         DateTime
  hours           Int           @default(0) // για Τ.Ω.Π.
  days            Int? // για Μόνιμο
  leaveType       String? // "LEAVE" | "DAYOFF" — μόνο για Μόνιμο
  shiftType       ShiftType? // Ημέρα/Νύχτα — μόνο για αιτήσεις υπαλλήλων Μονιάτη
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model BalanceAdjustment {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  category  BalanceCategory
  hours     Int
  reason    String?
  createdAt DateTime        @default(now())

  @@index([userId])
}

// Δύναμη (συνολικός αριθμός υπαλλήλων) ανά τμήμα
model StaffingRule {
  id              String @id @default(cuid())
  department      String
  shiftType       String @default("") // "" για κανονικά τμήματα· "DAY"/"NIGHT" μόνο για Μονιάτης
  actualStaff     Int    @default(0) // πραγματικό σύνολο προσωπικού
  totalForce      Int    @default(0) // ελάχιστο απαιτούμενο τις καθημερινές
  weekendMinStaff Int? // ελάχιστο απαιτούμενο Σαββατοκύριακα/αργίες (αν κενό, ισχύει το ίδιο με τις καθημερινές)

  @@unique([department, shiftType])
}

// Ημερομηνίες που ορίζονται ως αργίες (επηρεάζουν το ελάχιστο απαιτούμενο προσωπικό)
model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique
  name String?
}

// Άδειες ιατρού / εκπαίδευση: αφαιρούν άτομα από τη Δύναμη μόνο για συγκεκριμένη περίοδο
model StaffAbsence {
  id         String      @id @default(cuid())
  department String
  type       AbsenceType
  count      Int
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime    @default(now())

  @@index([department])
}

// Σημείο αναφοράς του κυκλικού κύκλου βαρδιών ανά τμήμα
model ShiftCycle {
  id               String   @id @default(cuid())
  department       String   @unique
  anchorDate       DateTime
  anchorGroupIndex Int      @default(0)
}

// Αίτημα ανταλλαγής βάρδιας μεταξύ δύο συναδέλφων
model ShiftSwap {
  id          String     @id @default(cuid())
  requesterId String
  requester   User       @relation("SwapRequester", fields: [requesterId], references: [id])
  colleagueId String
  colleague   User       @relation("SwapColleague", fields: [colleagueId], references: [id])
  date        DateTime
  status      SwapStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  decidedAt   DateTime?

  @@index([requesterId])
  @@index([colleagueId])
}
